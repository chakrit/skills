#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# ///
"""Read and type into the panes of the agents this control registers.

Reference script for the control skill. Run it from the control repo's scripts/,
inside the tmux server that holds the agents. The registry's Window and Agent pane are
the last-known IDs, which chakrit's own moves can make stale; every tmux call targets
that pane by its server-unique ID, and the pane is checked again before each keystroke,
so a stale ID is refused rather than typed into.
The script never creates, renames, resizes or moves windows or panes. Only wind-down
ends one: it exits the harness and then the pane's shell, which closes the pane.
"""

import argparse
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
import re
import subprocess
import sys
import time

SLUG = re.compile(r"[a-z0-9][a-z0-9-]*")
WINDOW = re.compile(r"@[0-9]+")
PANE = re.compile(r"%[0-9]+")
# A relative folder path whose parts never start with a dot, so never `.` or `..`.
CHECKOUT = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*")
# Agent names: machine:control, machine:org:control, machine:org:project.
SESSION_NAME = re.compile(r"[a-z0-9][a-z0-9_-]*(:[a-z0-9][a-z0-9_-]*){1,2}")
# The harness drops part of a paste when Enter follows at once.
PASTE_SETTLE_SECONDS = 1
# `/quit` exits Claude Code, Codex, opencode and pi; pi has no `/exit`.
HARNESS_EXIT_COMMAND = "/quit"
# A harness quits within a few seconds of its exit command; longer means it did not.
HARNESS_EXIT_SECONDS = 10
HARNESS_EXIT_POLL_SECONDS = 0.2
# One line per clear: time, slug, kind (`saved`, `wind-down`, `forced`), and where the
# save went or chakrit's ruling that forced it.
CLEAR_LOG = "clears.log"
BEFORE_A_CLEAR = ('the "Before a clear" section of engram entry rule/handling-agents '
                  "(fallback ~/Documents/control/rules/handling-agents.md)")
SAVED_HINT = f"run {BEFORE_A_CLEAR}, then pass --saved with where the save went"
CLEAR_DETAIL_HINTS = {
    "saved": SAVED_HINT,
    "wind-down": SAVED_HINT,
    "forced": "ask chakrit, then pass --ruling with chakrit's quoted words",
}


@dataclass(frozen=True)
class Agent:
    """A registered agent; Window and pane are empty when no pane is recorded."""
    slug: str
    checkout: Path
    window: str
    pane: str


def registry(repository: Path, home: Path) -> tuple[Path, Path]:
    """Return the registry file and the folder its Checkout column is relative to."""
    documents = home / "Documents"
    if repository == documents / "control":
        return repository / "registries/orgs.md", documents
    org = repository.parent
    if repository.name == "control" and org.parent == documents and org.name != "control":
        return repository / "registries/projects.md", org

    raise ValueError(f"{repository} is not a machine control or an org control")


def parse(text: str, root: Path) -> dict[str, Agent]:
    rows = (line.strip().strip("|").split("|") for line in text.splitlines()
            if line.strip().startswith("|"))
    cells = ([cell.strip() for cell in row] for row in rows)
    agents = (agent(row, root) for row in cells
              if len(row) == 4 and SLUG.fullmatch(row[0]))

    return {entry.slug: entry for entry in agents}


def agent(row: list[str], root: Path) -> Agent:
    slug, checkout, window, pane = row
    if not CHECKOUT.fullmatch(checkout):
        raise ValueError(f"{slug}: Checkout must be a folder inside {root}")
    unrecorded = window == "" and pane == ""
    if not unrecorded and not (WINDOW.fullmatch(window) and PANE.fullmatch(pane)):
        raise ValueError(f"{slug}: Window and Agent pane must be tmux IDs like @3, %7, "
                         "or both empty when no pane is recorded")

    return Agent(slug, root / checkout, window, pane)


def listing(registered: dict[str, Agent]) -> str:
    return "".join(listing_line(entry) for entry in registered.values())


def listing_line(entry: Agent) -> str:
    known = f"{entry.slug}\t{entry.window or '-'}\t{entry.pane or '-'}\t{entry.checkout}"
    return known + ("\n" if entry.pane else "\tno pane recorded\n")


def recorded_pane(entry: Agent) -> Agent:
    if not entry.pane:
        raise ValueError(f"{entry.slug} has no pane recorded; find its pane in tmux or "
                         "start it, then record the IDs in the registry")

    return entry


def check_pane(entry: Agent, info: str) -> int:
    """Check the pane is live, in its window and folder; return its shell's PID."""
    window, path, dead, pane_pid = info.rstrip("\n").split("\t")
    if dead != "0":
        raise ValueError(f"{entry.slug}: pane {entry.pane} is missing or dead")
    if window != entry.window:
        raise ValueError(f"{entry.slug}: pane {entry.pane} is not in {entry.window}")
    if Path(path) != entry.checkout:
        raise ValueError(f"{entry.slug}: pane {entry.pane} is not in {entry.checkout}")

    return int(pane_pid)


def shell_holds_foreground(pane_pid: int, ps_output: str) -> bool:
    """True when the pane's shell leads the terminal's foreground group: its prompt."""
    return int(ps_output.strip()) == pane_pid


def check_unwatched(entry: Agent, clients: str) -> None:
    if entry.pane in clients.split():
        raise ValueError(f"{entry.slug}: someone is viewing {entry.pane}; not typing")


def check_session_name(name: str) -> None:
    if not SESSION_NAME.fullmatch(name):
        raise ValueError(f"{name!r} is not an agent name like lz49:acme:web")


def clear_record(now: datetime, entry: Agent, kind: str, detail: str) -> str:
    if not (detail.strip() and detail.isprintable()):
        raise ValueError(f"{entry.slug}: {CLEAR_DETAIL_HINTS[kind]}, on one line")

    return f"{now.isoformat()}\t{entry.slug}\t{kind}\t{detail}\n"


def append_clear_record(repository: Path, record: str) -> None:
    with (repository / CLEAR_LOG).open("a", encoding="utf-8") as log:
        log.write(record)


def command(*arguments: str, stdin: str | None = None) -> str:
    return subprocess.run(arguments, input=stdin, capture_output=True, text=True,
                          check=True).stdout


def tmux(*arguments: str, stdin: str | None = None) -> str:
    return command("tmux", *arguments, stdin=stdin)


def at_prompt(entry: Agent) -> bool:
    """Verify the pane, then report whether its shell sits at its prompt."""
    pane_pid = check_pane(entry, tmux("display-message", "-p", "-t", entry.pane,
                                      "#{window_id}\t#{pane_current_path}\t"
                                      "#{pane_dead}\t#{pane_pid}"))
    return shell_holds_foreground(pane_pid,
                                  command("ps", "-o", "tpgid=", "-p", str(pane_pid)))


def check_harness(entry: Agent) -> None:
    if at_prompt(entry):
        raise ValueError(f"{entry.slug}: pane {entry.pane} shows a shell prompt, not a "
                         "harness; not typing")


def type_line(entry: Agent, text: str) -> None:
    buffer = f"control-{entry.slug}"
    check_harness(entry)
    check_unwatched(entry, tmux("list-clients", "-F", "#{pane_id}"))

    tmux("load-buffer", "-b", buffer, "-", stdin=text)
    tmux("paste-buffer", "-p", "-d", "-b", buffer, "-t", entry.pane)
    time.sleep(PASTE_SETTLE_SECONDS)
    check_harness(entry)
    tmux("send-keys", "-t", entry.pane, "Enter")


def clear(entry: Agent, record: str, repository: Path) -> None:
    type_line(entry, "/clear")
    append_clear_record(repository, record)


def wind_down(entry: Agent, record: str, repository: Path) -> None:
    clear(entry, record, repository)
    type_line(entry, HARNESS_EXIT_COMMAND)

    wait_for_prompt(entry)
    check_unwatched(entry, tmux("list-clients", "-F", "#{pane_id}"))
    tmux("send-keys", "-t", entry.pane, "exit", "Enter")


def wait_for_prompt(entry: Agent) -> None:
    deadline = time.monotonic() + HARNESS_EXIT_SECONDS
    while not at_prompt(entry):
        if time.monotonic() > deadline:
            raise ValueError(f"{entry.slug}: the harness in pane {entry.pane} did not exit "
                             f"within {HARNESS_EXIT_SECONDS}s; nothing was typed into the "
                             "shell")
        time.sleep(HARNESS_EXIT_POLL_SECONDS)


def inspect(entry: Agent) -> str:
    at_prompt(entry)
    return tmux("capture-pane", "-p", "-t", entry.pane, "-S", "-200")


def main(arguments: list[str]) -> int:
    commands = argparse.ArgumentParser(prog="control-agents", description=__doc__)
    actions = commands.add_subparsers(dest="command", required=True)
    actions.add_parser("list", help="print the registered agents and their last-known panes")
    for name, text in (("inspect", "print the last 200 lines of the agent's pane"),
                       ("send", "type the message on stdin and press Enter")):
        actions.add_parser(name, help=text).add_argument("slug")
    saved_help = ("where the agent reported its save went, such as an engram observation "
                  "or a session file; logged to " + CLEAR_LOG)
    clearing = actions.add_parser(
        "clear-context", help=f"type /clear; run {BEFORE_A_CLEAR} first",
        epilog=f"Run {BEFORE_A_CLEAR} first. A bare /clear can drop unsaved work.")
    clearing.add_argument("slug")
    clearing.add_argument("--saved", default="", metavar="LOCATION", help=saved_help)
    down = actions.add_parser(
        "wind-down", help="clear, exit the harness, then exit the pane's shell",
        epilog=f"Run {BEFORE_A_CLEAR} first. chakrit's \"stop\", \"wind down\" or "
               "\"shut down\" for an agent mean this. Afterwards empty the agent's "
               "Window and Agent pane cells in the registry.")
    down.add_argument("slug")
    down.add_argument("--saved", default="", metavar="LOCATION", help=saved_help)
    force = actions.add_parser(
        "force-clear", help="type /clear without a save; lossy, only on chakrit's ruling",
        epilog=f"Skips {BEFORE_A_CLEAR}, so unsaved work is lost. A last resort, allowed "
               "only on chakrit's ruling: chakrit ordered a clear without a save, or "
               "approved one because the agent is stuck or hung, agents are being torn "
               "down, or another special circumstance requires it. Ask chakrit first.")
    force.add_argument("slug")
    force.add_argument("--ruling", default="", metavar="TEXT",
                       help="chakrit's quoted words ordering or approving the clear; "
                            "logged to " + CLEAR_LOG)
    rename = actions.add_parser("rename-session", help="type /rename NAME")
    rename.add_argument("slug")
    rename.add_argument("name")
    options = commands.parse_args(arguments)

    repository = Path(__file__).resolve().parent.parent
    try:
        path, root = registry(repository, Path.home().resolve())
        agents = parse(path.read_text(encoding="utf-8"), root)
        output = run(options, agents, repository)
    except subprocess.CalledProcessError as error:
        print(f"control-agents: {error.cmd[0]}: {error.stderr.strip()}", file=sys.stderr)
        return 1
    except (OSError, ValueError) as error:
        print(f"control-agents: {error}", file=sys.stderr)
        return 1

    print(output, end="")
    return 0


def run(options: argparse.Namespace, agents: dict[str, Agent], repository: Path) -> str:
    if options.command == "list":
        return listing(agents)
    if options.slug not in agents:
        raise ValueError(f"{options.slug} is not in the registry")
    entry = recorded_pane(agents[options.slug])
    now = datetime.now().astimezone()

    if options.command == "inspect":
        return inspect(entry)
    if options.command == "send":
        type_line(entry, sys.stdin.read().rstrip("\n"))
    elif options.command == "clear-context":
        clear(entry, clear_record(now, entry, "saved", options.saved), repository)
    elif options.command == "wind-down":
        wind_down(entry, clear_record(now, entry, "wind-down", options.saved), repository)
    elif options.command == "force-clear":
        clear(entry, clear_record(now, entry, "forced", options.ruling), repository)
    else:
        check_session_name(options.name)
        type_line(entry, f"/rename {options.name}")

    return ""


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
