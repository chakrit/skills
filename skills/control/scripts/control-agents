#!/usr/bin/env python3
"""Read and type into the panes of the agents this control registers.

Reference script for the control skill. Run it from the control repo's scripts/,
inside the tmux server that holds the agents. Every tmux call targets the registered
pane by its server-unique ID, and the pane is checked again before each keystroke.
The script never creates, renames, resizes or moves windows or panes.
"""

import argparse
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
import re
import subprocess
import sys
import time

HARNESSES = frozenset({"claude", "codex"})
SLUG = re.compile(r"[a-z0-9][a-z0-9-]*")
WINDOW = re.compile(r"@[0-9]+")
PANE = re.compile(r"%[0-9]+")
# A relative folder path whose parts never start with a dot, so never `.` or `..`.
CHECKOUT = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*")
# Agent names: machine:control, machine:org:control, machine:org:project.
SESSION_NAME = re.compile(r"[a-z0-9][a-z0-9_-]*(:[a-z0-9][a-z0-9_-]*){1,2}")
# The harness drops part of a paste when Enter follows at once.
PASTE_SETTLE_SECONDS = 1
# One line per clear: time, slug, `saved` and where the save went, or `forced` and why.
CLEAR_LOG = "clears.log"
BEFORE_A_CLEAR = ('the "Before a clear" section of engram entry rule/handling-agents '
                  "(fallback ~/Documents/control/rules/handling-agents.md)")


@dataclass(frozen=True)
class Agent:
    slug: str
    checkout: Path
    window: str
    pane: str


def registry(repository: Path, home: Path) -> tuple[Path, Path]:
    """Return the registry file and the folder its Checkout column is relative to."""
    documents = home / "Documents"
    if repository == documents / "control":
        return repository / "registries/orgs.md", documents
    org = repository.parent
    if repository.name == "control" and org.parent == documents and org.name != "control":
        return repository / "registries/projects.md", org

    raise ValueError(f"{repository} is not a machine control or an org control")


def parse(text: str, root: Path) -> dict[str, Agent]:
    rows = (line.strip().strip("|").split("|") for line in text.splitlines()
            if line.strip().startswith("|"))
    cells = ([cell.strip() for cell in row] for row in rows)
    agents = (agent(row, root) for row in cells
              if len(row) == 6 and SLUG.fullmatch(row[0]))

    return {entry.slug: entry for entry in agents}


def agent(row: list[str], root: Path) -> Agent:
    slug, checkout, window, pane = row[:4]
    if not WINDOW.fullmatch(window) or not PANE.fullmatch(pane):
        raise ValueError(f"{slug}: Window and Agent pane must be tmux IDs like @3, %7")
    if not CHECKOUT.fullmatch(checkout):
        raise ValueError(f"{slug}: Checkout must be a folder inside {root}")

    return Agent(slug, root / checkout, window, pane)


def check_pane(entry: Agent, info: str) -> None:
    window, path, command, dead = info.rstrip("\n").split("\t")
    if dead != "0":
        raise ValueError(f"{entry.slug}: pane {entry.pane} is missing or dead")
    if window != entry.window:
        raise ValueError(f"{entry.slug}: pane {entry.pane} is not in {entry.window}")
    if Path(path) != entry.checkout:
        raise ValueError(f"{entry.slug}: pane {entry.pane} is not in {entry.checkout}")
    if command not in HARNESSES:
        raise ValueError(f"{entry.slug}: pane {entry.pane} runs {command}, not a harness")


def check_unwatched(entry: Agent, clients: str) -> None:
    if entry.pane in clients.split():
        raise ValueError(f"{entry.slug}: someone is viewing {entry.pane}; not typing")


def check_session_name(name: str) -> None:
    if not SESSION_NAME.fullmatch(name):
        raise ValueError(f"{name!r} is not an agent name like lz49:acme:web")


def saved_clear_record(entry: Agent, location: str, now: datetime) -> str:
    if not one_printed_line(location):
        raise ValueError(f"{entry.slug}: run {BEFORE_A_CLEAR}, then pass --saved with "
                         "where the save went, on one line")

    return clear_line(now, entry, "saved", location)


def forced_clear_record(entry: Agent, reason: str, now: datetime) -> str:
    if not one_printed_line(reason):
        raise ValueError(f"{entry.slug}: pass --reason with chakrit's quoted words or "
                         "what happened, on one line")

    return clear_line(now, entry, "forced", reason)


def one_printed_line(text: str) -> bool:
    return bool(text.strip()) and text.isprintable()


def clear_line(now: datetime, entry: Agent, kind: str, detail: str) -> str:
    return f"{now.isoformat()}\t{entry.slug}\t{kind}\t{detail}\n"


def append_clear_record(repository: Path, record: str) -> None:
    with (repository / CLEAR_LOG).open("a", encoding="utf-8") as log:
        log.write(record)


def tmux(*arguments: str, stdin: str | None = None) -> str:
    return subprocess.run(("tmux", *arguments), input=stdin, capture_output=True,
                          text=True, check=True).stdout


def verify(entry: Agent) -> None:
    check_pane(entry, tmux("display-message", "-p", "-t", entry.pane,
                           "#{window_id}\t#{pane_current_path}\t"
                           "#{pane_current_command}\t#{pane_dead}"))


def type_line(entry: Agent, text: str) -> None:
    buffer = f"control-{entry.slug}"
    verify(entry)
    check_unwatched(entry, tmux("list-clients", "-F", "#{pane_id}"))

    tmux("load-buffer", "-b", buffer, "-", stdin=text)
    tmux("paste-buffer", "-p", "-d", "-b", buffer, "-t", entry.pane)
    time.sleep(PASTE_SETTLE_SECONDS)
    verify(entry)
    tmux("send-keys", "-t", entry.pane, "Enter")


def clear_and_log(entry: Agent, record: str, repository: Path) -> None:
    type_line(entry, "/clear")
    append_clear_record(repository, record)


def inspect(entry: Agent) -> str:
    verify(entry)
    return tmux("capture-pane", "-p", "-t", entry.pane, "-S", "-200")


def main(arguments: list[str]) -> int:
    commands = argparse.ArgumentParser(prog="control-agents", description=__doc__)
    actions = commands.add_subparsers(dest="command", required=True)
    actions.add_parser("list", help="print the registered agents")
    for name, text in (("inspect", "print the last 200 lines of the agent's pane"),
                       ("send", "type the message on stdin and press Enter")):
        actions.add_parser(name, help=text).add_argument("slug")
    clear = actions.add_parser(
        "clear-context", help=f"type /clear; run {BEFORE_A_CLEAR} first",
        epilog=f"Run {BEFORE_A_CLEAR} first. A bare /clear can drop unsaved work.")
    clear.add_argument("slug")
    clear.add_argument("--saved", default="", metavar="LOCATION",
                       help="where the agent reported its save went, such as an engram "
                            "observation or a session file; logged to " + CLEAR_LOG)
    force = actions.add_parser(
        "force-clear", help="type /clear without a save; lossy, see its --help for when",
        epilog=f"Skips {BEFORE_A_CLEAR}, so unsaved work is lost. Allowed only when "
               "chakrit ordered a clear without a save, the agent is stuck or hung, "
               "agents are being torn down, or another special circumstance requires it.")
    force.add_argument("slug")
    force.add_argument("--reason", default="", metavar="TEXT",
                       help="chakrit's quoted words, or what happened; logged to "
                            + CLEAR_LOG)
    rename = actions.add_parser("rename-session", help="type /rename NAME")
    rename.add_argument("slug")
    rename.add_argument("name")
    options = commands.parse_args(arguments)

    repository = Path(__file__).resolve().parent.parent
    try:
        path, root = registry(repository, Path.home().resolve())
        agents = parse(path.read_text(encoding="utf-8"), root)
        output = run(options, agents, repository)
    except subprocess.CalledProcessError as error:
        print(f"control-agents: tmux: {error.stderr.strip()}", file=sys.stderr)
        return 1
    except (OSError, ValueError) as error:
        print(f"control-agents: {error}", file=sys.stderr)
        return 1

    print(output, end="")
    return 0


def run(options: argparse.Namespace, agents: dict[str, Agent], repository: Path) -> str:
    if options.command == "list":
        return "".join(f"{entry.slug}\t{entry.window}\t{entry.pane}\t{entry.checkout}\n"
                       for entry in agents.values())
    if options.slug not in agents:
        raise ValueError(f"{options.slug} is not in the registry")
    entry = agents[options.slug]

    if options.command == "inspect":
        return inspect(entry)
    if options.command == "send":
        type_line(entry, sys.stdin.read().rstrip("\n"))
    elif options.command == "clear-context":
        record = saved_clear_record(entry, options.saved, datetime.now().astimezone())
        clear_and_log(entry, record, repository)
    elif options.command == "force-clear":
        record = forced_clear_record(entry, options.reason, datetime.now().astimezone())
        clear_and_log(entry, record, repository)
    else:
        check_session_name(options.name)
        type_line(entry, f"/rename {options.name}")

    return ""


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
