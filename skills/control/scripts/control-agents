#!/usr/bin/env python3
"""Inspect registered windows and dispatch approved actions using reviewed receipts."""

import argparse
from contextlib import contextmanager
from dataclasses import asdict, dataclass, fields
import datetime
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import traceback
from typing import Callable, ContextManager, Iterator, Mapping
import uuid

from agent_status import STALE_AFTER, Records, render, report_cleared
from control_config import Config, ExitConfirmation, load
from control_registry import Project, load_projects
from runtime_directory import runtime_directory
from tmux_transport import Connection


@dataclass(frozen=True)
class Snapshot:
    slug: str
    created: float
    socket: str
    metadata: tuple[str, ...]
    capture: str

    @classmethod
    def parse(cls, raw: object) -> "Snapshot":
        if not isinstance(raw, dict) or set(raw) != {field.name for field in fields(cls)}:
            raise ValueError("Malformed snapshot fields")
        if any(not isinstance(raw[key], str) for key in ("slug", "socket", "capture")):
            raise ValueError("Malformed snapshot text")
        if type(raw["created"]) not in (int, float):
            raise ValueError("Malformed snapshot timestamp")
        metadata = raw["metadata"]
        if not isinstance(metadata, list) or len(metadata) != 9:
            raise ValueError("Malformed snapshot metadata")
        if any(not isinstance(value, str) for value in metadata):
            raise ValueError("Malformed snapshot metadata values")

        return cls(raw["slug"], raw["created"], raw["socket"], tuple(metadata), raw["capture"])


# The agent UI debounces bracketed paste; an immediate Enter can truncate the body.
PASTE_SETTLE_SECONDS = 1

Pause = Callable[[float], None]

# The pane's foreground process: the harness while it runs (control.toml `harness`), the
# shell once it exits. A shell in the foreground means no job is running in it.
SHELL_PROCESSES = frozenset({"zsh", "bash", "sh", "fish"})


class Tmux:
    """Validate registered agent panes and own buffered submission."""

    def __init__(self, config: Config, pause: Pause) -> None:
        self.config = config
        self.connection = Connection(config.tmux_socket)
        self.pause = pause

    def clients(self, projects: Mapping[str, Project]) -> tuple["Client", ...]:
        output = self.connection.run("list-clients", "-F",
                                     "#{client_name}\t#{session_name}\t#{pane_id}")
        clients = tuple(Client.parse(line, projects, self.config.tmux_session)
                        for line in output.splitlines())
        if len({client.name for client in clients}) != len(clients):
            raise ValueError("Duplicate tmux client identity")

        return clients

    def inspect(self, project: Project) -> Snapshot:
        metadata = self.metadata(project, self.config.harness)
        capture = self.connection.run("capture-pane", "-p", "-t", metadata[0], "-S", "-200")
        if self.metadata(project, self.config.harness) != metadata:
            raise ValueError("Pane changed while capturing; inspect again")

        return Snapshot(project.slug, time.time(), self.config.tmux_socket, metadata, capture)

    def metadata(self, project: Project, processes: frozenset[str]) -> tuple[str, ...]:
        pane = project.agent_pane
        output = self.connection.run(
            "display-message", "-p", "-t", pane,
            "#{pane_id}\t#{window_id}\t#{session_name}\t#{pane_current_path}\t"
            "#{pane_current_command}\t#{pane_dead}\t#{pane_pid}\t#{pane_width}\t#{pane_height}",
        )
        metadata = tuple(output.rstrip("\n").split("\t"))
        registered = (pane, project.window, self.config.tmux_session)
        if len(metadata) != 9 or metadata[:3] != registered:
            raise ValueError("Pane no longer matches registered window/session")
        if metadata[5] != "0":
            raise ValueError("Pane is not live")
        if metadata[3] != str(project.checkout) or metadata[4] not in processes:
            raise ValueError("Pane no longer matches registered checkout/process")
        if any(not value.isdecimal() for value in metadata[6:]):
            raise ValueError("Malformed pane process or dimensions")

        return metadata

    def refuse_focused(self, project: Project) -> None:
        focus = self.connection.run("list-clients", "-F", "#{pane_id}").splitlines()
        if any(not value.startswith("%") or not value[1:].isdecimal() for value in focus):
            raise ValueError("Malformed client focus data")
        if project.agent_pane in focus:
            raise ValueError("Recipient is focused by a client; preserve manual input")

    def submit(self, project: Project, snapshot: Snapshot, payload: str,
               store: "Store", identifier: str) -> None:
        buffer = f"control-{identifier}"
        self.connection.run("load-buffer", "-b", buffer, "-", body=payload)
        try:
            self.paste_and_submit(project, snapshot, buffer, store, identifier)
        except (ValueError, OSError, subprocess.CalledProcessError) as error:
            try:
                self.connection.run("delete-buffer", "-b", buffer)
            except (OSError, subprocess.CalledProcessError) as cleanup_error:
                error.add_note(f"Own buffer cleanup also failed: {cleanup_error}")
            raise
        else:
            self.connection.run("delete-buffer", "-b", buffer)

    def confirm_exit(self, project: Project, snapshot: Snapshot,
                     confirmation: ExitConfirmation, store: "Store", identifier: str) -> None:
        current = self.inspect(project)
        self.refuse_focused(project)
        if current.metadata != snapshot.metadata or current.capture != snapshot.capture:
            raise ValueError("Exit confirmation changed; no Enter performed")
        require_exit_confirmation(current.capture, confirmation)

        self.submit_enter(snapshot, store, identifier)

    def paste_and_submit(self, project: Project, snapshot: Snapshot, buffer: str,
                         store: "Store", identifier: str) -> None:
        current = self.inspect(project)
        self.refuse_focused(project)
        if current.metadata != snapshot.metadata or current.capture != snapshot.capture:
            raise ValueError("Pane changed before paste; no paste performed")

        self.connection.run("paste-buffer", "-p", "-b", buffer, "-t", snapshot.metadata[0])
        store.event(identifier, "pasted", {})
        self.pause(PASTE_SETTLE_SECONDS)
        if self.metadata(project, self.config.harness) != snapshot.metadata:
            raise ValueError("Pane changed after paste; Enter withheld, inspect manually")
        self.refuse_focused(project)
        self.submit_enter(snapshot, store, identifier)

    def submit_enter(self, snapshot: Snapshot, store: "Store", identifier: str) -> None:
        self.connection.run("send-keys", "-t", snapshot.metadata[0], "Enter")
        store.event(identifier, "submission-attempted-unacknowledged", {})

    def exit_shell(self, project: Project) -> None:
        """Type `exit` into the idle shell a harness left behind; the checks run just before."""
        pane = self.metadata(project, SHELL_PROCESSES)[0]
        self.refuse_focused(project)

        self.connection.run("send-keys", "-t", pane, "-l", "exit")
        self.connection.run("send-keys", "-t", pane, "Enter")


@dataclass(frozen=True)
class Client:
    name: str
    session: str
    pane: str
    slug: str

    @classmethod
    def parse(cls, line: str, projects: Mapping[str, Project], session: str) -> "Client":
        values = line.split("\t")
        if len(values) != 3 or any(not value for value in values):
            raise ValueError("Malformed tmux client record")
        name, client_session, pane = values
        if not pane.startswith("%") or not pane[1:].isdecimal():
            raise ValueError("Malformed tmux client pane")
        matches = tuple(project for project in projects.values()
                        if project.agent_pane == pane and client_session == session)
        slug = matches[0].slug if matches else ""

        return cls(name, client_session, pane, slug)


class Store:
    """Own confined runtime receipts, locks, captures, and append-only delivery events."""

    def __init__(self, repository: Path) -> None:
        self.repository = repository
        self.root = repository / ".ace" / "tmux"

    def directory(self) -> ContextManager[int]:
        return runtime_directory(self.repository, "tmux")

    def create(self, filename: str, body: str) -> None:
        with self.directory() as directory:
            descriptor = os.open(filename, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW,
                                 0o600, dir_fd=directory)
            with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
                stream.write(body)
                stream.flush()
                os.fsync(stream.fileno())

    def inspect(self, snapshot: Snapshot) -> dict[str, str]:
        identifier = str(uuid.uuid4())
        self.create(f"{identifier}.txt", snapshot.capture)
        self.create(f"{identifier}.json", json.dumps(asdict(snapshot)))

        return {"slug": snapshot.slug, "snapshot": identifier,
                "capture_path": str(self.root / f"{identifier}.txt"),
                "metadata_path": str(self.root / f"{identifier}.json")}

    def read(self, identifier: str) -> Snapshot:
        if str(uuid.UUID(identifier)) != identifier:
            raise ValueError("Snapshot must be a canonical UUID receipt")
        with self.directory() as directory:
            descriptor = os.open(f"{identifier}.json", os.O_RDONLY | os.O_NOFOLLOW,
                                 dir_fd=directory)
            with os.fdopen(descriptor, "r", encoding="utf-8") as stream:
                raw = json.load(stream)

        return Snapshot.parse(raw)

    @contextmanager
    def lock(self, slug: str) -> Iterator[None]:
        with self.directory() as directory:
            descriptor = os.open(f"{slug}.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW,
                                 0o600, dir_fd=directory)
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                yield
            finally:
                os.close(descriptor)

    def event(self, identifier: str, state: str, fields: dict[str, str]) -> None:
        event = {"snapshot": identifier, "state": state, "time": time.time(), **fields}
        self.create(f"{identifier}.{state}.json", json.dumps(event, ensure_ascii=False))


def send(project: Project, identifier: str, body: str, tmux: Tmux,
         store: Store) -> dict[str, str]:
    invalid_controls = any((ord(char) < 32 and char not in "\n\t") or ord(char) == 127
                           for char in body)
    if not body.strip() or invalid_controls:
        raise ValueError("Body must contain text without terminal control characters")
    if any(line.upper().startswith("FROM:") for line in body.splitlines()):
        raise ValueError("Sender identity is supplied by control-agents")
    sender = tmux.config.sender
    payload = sender + "\n\n" + body

    evidence = {"action": "send", "payload": payload, "sender": sender}

    return dispatch(project, identifier, evidence,
                    paste(project, payload, tmux, store, identifier), tmux, store)


def clear_context(project: Project, identifier: str, checkpoint: str, tmux: Tmux,
                  store: Store) -> dict[str, str]:
    validate_checkpoint(project, checkpoint)
    evidence = {"action": "clear-context", "payload": "/clear",
                "sender": tmux.config.sender, "checkpoint": checkpoint}

    result = dispatch(project, identifier, evidence,
                      paste(project, "/clear", tmux, store, identifier), tmux, store)

    return {**result, "status_record": mark_cleared(project, tmux.config.repository)}


def mark_cleared(project: Project, repository: Path) -> str:
    """Set the cleared agent's status record; a failure is reported, never hides the clear."""
    now = datetime.datetime.now(datetime.timezone.utc)
    try:
        Records(repository).update(
            project.slug, lambda previous: report_cleared(previous, project.slug, now))
    except (OSError, ValueError) as error:
        return f"not updated: {error_detail(error)}"

    return "cleared"


# Agent names in the control hierarchy: machine:control, machine:org:control and
# machine:org:project.
SESSION_NAME = re.compile(r"[a-z0-9][a-z0-9_-]*(:[a-z0-9][a-z0-9_-]*){1,2}")


def rename_session(project: Project, identifier: str, name: str, tmux: Tmux,
                   store: Store) -> dict[str, str]:
    if not SESSION_NAME.fullmatch(name):
        raise ValueError("Session name must be two or three colon-separated parts in "
                         "lowercase letters, digits, hyphens or underscores")
    command = f"/rename {name}"
    evidence = {"action": "rename-session", "payload": command,
                "sender": tmux.config.sender, "name": name}

    return dispatch(project, identifier, evidence,
                    paste(project, command, tmux, store, identifier), tmux, store)


def exit_agent(project: Project, identifier: str, checkpoint: str, tmux: Tmux,
               store: Store) -> dict[str, str]:
    validate_checkpoint(project, checkpoint)
    evidence = {"action": "exit-agent", "payload": "/exit", "sender": tmux.config.sender,
                "checkpoint": checkpoint}

    return dispatch(project, identifier, evidence,
                    paste(project, "/exit", tmux, store, identifier), tmux, store)


def confirm_exit(project: Project, identifier: str, checkpoint: str, tmux: Tmux,
                 store: Store) -> dict[str, str]:
    confirmation = tmux.config.exit_confirmation
    if confirmation is None:
        raise ValueError("confirm-exit needs an [exit_confirmation] table in control.toml")
    validate_checkpoint(project, checkpoint)
    require_exit_confirmation(store.read(identifier).capture, confirmation)
    evidence = {"action": "confirm-exit", "payload": "Enter", "sender": tmux.config.sender,
                "checkpoint": checkpoint}

    return dispatch(project, identifier, evidence,
                    lambda snapshot: tmux.confirm_exit(project, snapshot, confirmation,
                                                       store, identifier),
                    tmux, store)


def exit_shell(project: Project, tmux: Tmux, store: Store) -> dict[str, str]:
    identifier = str(uuid.uuid4())
    evidence = {"slug": project.slug, "action": "exit-shell", "sender": tmux.config.sender}

    with store.lock(project.slug):
        store.event(identifier, "attempted", evidence)
        try:
            tmux.exit_shell(project)
        except (ValueError, OSError, subprocess.CalledProcessError) as error:
            store.event(identifier, "failed", {"error": error_detail(error)})
            raise

    return {"slug": project.slug, "receipt": identifier, "state": "exit-sent-unacknowledged"}


def require_exit_confirmation(capture: str, confirmation: ExitConfirmation) -> None:
    lines = tuple(line.strip() for line in capture.splitlines() if line.strip())
    selections = tuple(line for line in lines if line.startswith(confirmation.marker))
    if (not lines or lines[-1] != confirmation.footer or confirmation.notice not in lines
            or selections != (f"{confirmation.marker} {confirmation.option}",)):
        raise ValueError("Recognized active exit confirmation with selected stop option required")


def validate_checkpoint(project: Project, checkpoint: str) -> None:
    path = Path(checkpoint)
    if not path.is_absolute() or ".." in path.parts or path == project.checkout:
        raise ValueError("Checkpoint must be an absolute file path in the registered checkout")
    if not path.is_relative_to(project.checkout):
        raise ValueError("Checkpoint is outside the registered checkout")
    if any(ord(char) < 32 or ord(char) == 127 for char in checkpoint):
        raise ValueError("Malformed checkpoint path")


Delivery = Callable[[Snapshot], None]


def paste(project: Project, payload: str, tmux: Tmux, store: Store,
          identifier: str) -> Delivery:
    return lambda snapshot: tmux.submit(project, snapshot, payload, store, identifier)


def dispatch(project: Project, identifier: str, evidence: dict[str, str],
             deliver: Delivery, tmux: Tmux, store: Store) -> dict[str, str]:
    snapshot = store.read(identifier)
    if snapshot.slug != project.slug or snapshot.socket != tmux.config.tmux_socket:
        raise ValueError("Receipt belongs to another slug or socket")
    if (snapshot.metadata[0] != project.agent_pane
            or snapshot.metadata[4] not in tmux.config.harness):
        raise ValueError("Agent operation requires the registered agent snapshot")
    age = time.time() - snapshot.created
    if not 0 <= age <= 120:
        raise ValueError("Snapshot is stale; inspect and review again")

    with store.lock(project.slug):
        current = tmux.inspect(project)
        tmux.refuse_focused(project)
        if current.metadata != snapshot.metadata or current.capture != snapshot.capture:
            raise ValueError("Reviewed snapshot changed; inspect and review again")
        store.event(identifier, "attempted", {"slug": project.slug, **evidence})
        try:
            deliver(snapshot)
        except (ValueError, OSError, subprocess.CalledProcessError) as error:
            store.event(identifier, "failed", {"error": error_detail(error)})
            raise

    return {"slug": project.slug, "snapshot": identifier,
            "state": "submission-attempted-unacknowledged"}


def status_table(projects: Mapping[str, Project], slug: str | None, stale_minutes: int,
                 repository: Path) -> str:
    if slug is not None and slug not in projects:
        raise ValueError("Unknown registered project slug")
    slugs = (slug,) if slug is not None else tuple(projects)
    records = Records(repository)

    rows = tuple((name, records.observe(name)) for name in slugs)
    now = datetime.datetime.now(datetime.timezone.utc)

    return render(rows, now, datetime.timedelta(minutes=stale_minutes))


def positive_minutes(value: str) -> int:
    minutes = int(value)
    if minutes <= 0:
        raise argparse.ArgumentTypeError("must be a positive number of minutes")

    return minutes


def error_detail(error: BaseException) -> str:
    return "".join(traceback.format_exception_only(type(error), error)).rstrip("\n")


def main(argv: list[str], pause: Pause) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("list")
    commands.add_parser("clients")
    status = commands.add_parser("status", help="table of agents' self-reported status")
    status.add_argument("slug", nargs="?")
    status.add_argument("--stale-minutes", type=positive_minutes,
                        default=int(STALE_AFTER.total_seconds() // 60))
    inspect = commands.add_parser("inspect")
    inspect.add_argument("slug")
    delivery = commands.add_parser("send")
    delivery.add_argument("slug")
    delivery.add_argument("--snapshot", required=True)
    clear = commands.add_parser("clear-context")
    clear.add_argument("slug")
    clear.add_argument("--snapshot", required=True)
    clear.add_argument("--checkpoint", required=True)
    rename = commands.add_parser("rename-session")
    rename.add_argument("slug")
    rename.add_argument("--snapshot", required=True)
    rename.add_argument("--name", required=True)
    agent_exit = commands.add_parser("exit-agent")
    agent_exit.add_argument("slug")
    agent_exit.add_argument("--snapshot", required=True)
    agent_exit.add_argument("--checkpoint", required=True)
    confirmation = commands.add_parser("confirm-exit")
    confirmation.add_argument("slug")
    confirmation.add_argument("--snapshot", required=True)
    confirmation.add_argument("--checkpoint", required=True)
    shell_exit = commands.add_parser(
        "exit-shell", help="type exit into the idle shell left after the harness exits")
    shell_exit.add_argument("slug")
    arguments = parser.parse_args(argv)
    repository = Path(__file__).resolve().parent.parent

    try:
        config = load(repository)
        projects = load_projects(config)
        if arguments.command == "status":
            print(status_table(projects, arguments.slug, arguments.stale_minutes, repository),
                  end="")
            return 0
        if arguments.command == "list":
            result = {"projects": [{"slug": project.slug, "checkout": str(project.checkout),
                                    "pane": project.agent_pane, "window": project.window}
                                   for project in projects.values()]}
        elif arguments.command == "clients":
            result = {"clients": [asdict(client)
                                  for client in Tmux(config, pause).clients(projects)]}
        else:
            if arguments.slug not in projects:
                raise ValueError("Unknown registered project slug")
            project = projects[arguments.slug]
            tmux, store = Tmux(config, pause), Store(repository)
            if arguments.command == "inspect":
                result = store.inspect(tmux.inspect(project))
            elif arguments.command == "exit-agent":
                result = exit_agent(project, arguments.snapshot, arguments.checkpoint,
                                    tmux, store)
            elif arguments.command == "exit-shell":
                result = exit_shell(project, tmux, store)
            elif arguments.command == "confirm-exit":
                result = confirm_exit(project, arguments.snapshot, arguments.checkpoint,
                                      tmux, store)
            elif arguments.command == "clear-context":
                result = clear_context(project, arguments.snapshot, arguments.checkpoint,
                                       tmux, store)
            elif arguments.command == "rename-session":
                result = rename_session(project, arguments.snapshot, arguments.name,
                                        tmux, store)
            else:
                result = send(project, arguments.snapshot, sys.stdin.read(), tmux, store)
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f"control-agents: {error_detail(error)}", file=sys.stderr)
        return 1

    print(json.dumps(result, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], time.sleep))
